[
  { "section": "Wintermute" },
  { "bind": "Mod+Grave", "label": "Collapse or expand the sidebar", "ipc": "sidebar toggle", "overlay": true },
  { "bind": "Mod+E", "label": "Launcher", "waits": "F5", "overlay": true },
  { "bind": "Mod+Escape", "label": "Settings", "ipc": "settings toggle", "overlay": true },
  { "bind": "Mod+L", "label": "Lock screen", "waits": "F7", "overlay": true },
  { "bind": "Mod+Shift+1", "label": "Screenshot a region", "niri": "screenshot" },
  { "bind": "Mod+Shift+2", "label": "Screenshot the screen", "niri": "screenshot-screen" },
  { "bind": "Mod+Shift+3", "label": "Screenshot the window", "niri": "screenshot-window" },

  { "section": "Applications" },
  { "bind": "Mod+Return", "label": "Terminal", "spawn": "ghostty", "overlay": true },
  { "bind": "Mod+Shift+E", "label": "Files", "spawn": "nautilus", "overlay": true },

  { "section": "Windows" },
  { "bind": "Mod+Q", "label": "Close window", "niri": "close-window" },
  { "bind": "Mod+A", "label": "Focus column left", "niri": "focus-column-left" },
  { "bind": "Mod+D", "label": "Focus column right", "niri": "focus-column-right" },
  { "bind": "Mod+Up", "label": "Focus window above", "niri": "focus-window-up" },
  { "bind": "Mod+Down", "label": "Focus window below", "niri": "focus-window-down" },
  { "bind": "Mod+Shift+A", "label": "Move column left", "niri": "move-column-left" },
  { "bind": "Mod+Shift+D", "label": "Move column right", "niri": "move-column-right" },
  { "bind": "Mod+Shift+Up", "label": "Move window up", "niri": "move-window-up" },
  { "bind": "Mod+Shift+Down", "label": "Move window down", "niri": "move-window-down" },
  { "bind": "Mod+BracketLeft", "label": "Consume or expel window left", "niri": "consume-or-expel-window-left" },
  { "bind": "Mod+BracketRight", "label": "Consume or expel window right", "niri": "consume-or-expel-window-right" },
  { "bind": "Mod+Right", "label": "Consume window into column", "niri": "consume-window-into-column" },
  { "bind": "Mod+Left", "label": "Expel window from column", "niri": "expel-window-from-column" },
  { "bind": "Mod+Shift+V", "label": "Focus floating or tiling", "niri": "switch-focus-between-floating-and-tiling" },
  { "bind": "Mod+WheelScrollLeft", "label": "Focus column left", "niri": "focus-column-left" },
  { "bind": "Mod+WheelScrollRight", "label": "Focus column right", "niri": "focus-column-right" },
  { "bind": "Mod+Shift+WheelScrollLeft", "label": "Move column left", "niri": "move-column-left" },
  { "bind": "Mod+Shift+WheelScrollRight", "label": "Move column right", "niri": "move-column-right" },

  { "section": "Workspaces" },
  { "bind": "Mod+Tab", "label": "Overview", "niri": "toggle-overview", "options": "repeat=false" },
  { "keys": ["Super", "Wheel"], "label": "Switch workspace", "binds": [
      { "bind": "Mod+WheelScrollDown", "niri": "focus-workspace-down", "options": "cooldown-ms=150" },
      { "bind": "Mod+WheelScrollUp", "niri": "focus-workspace-up", "options": "cooldown-ms=150" } ] },
  { "keys": ["Super", "Shift", "Wheel"], "label": "Move column to workspace", "binds": [
      { "bind": "Mod+Shift+WheelScrollDown", "niri": "move-column-to-workspace-down", "options": "cooldown-ms=150" },
      { "bind": "Mod+Shift+WheelScrollUp", "niri": "move-column-to-workspace-up", "options": "cooldown-ms=150" } ] },
  { "keys": ["Super", "1–9"], "label": "Focus workspace 1 to 9", "binds": [
      { "bind": "Mod+1", "niri": "focus-workspace 1" },
      { "bind": "Mod+2", "niri": "focus-workspace 2" },
      { "bind": "Mod+3", "niri": "focus-workspace 3" },
      { "bind": "Mod+4", "niri": "focus-workspace 4" },
      { "bind": "Mod+5", "niri": "focus-workspace 5" },
      { "bind": "Mod+6", "niri": "focus-workspace 6" },
      { "bind": "Mod+7", "niri": "focus-workspace 7" },
      { "bind": "Mod+8", "niri": "focus-workspace 8" },
      { "bind": "Mod+9", "niri": "focus-workspace 9" } ] },
  { "bind": "Mod+Shift+W", "label": "Move column to monitor above", "niri": "move-column-to-monitor-up" },
  { "bind": "Mod+Shift+S", "label": "Move column to monitor below", "niri": "move-column-to-monitor-down" },

  { "section": "Layout" },
  { "bind": "Mod+R", "label": "Next column width", "niri": "switch-preset-column-width" },
  { "bind": "Mod+Shift+R", "label": "Previous column width", "niri": "switch-preset-column-width-back" },
  { "bind": "Mod+Ctrl+Shift+R", "label": "Next window height", "niri": "switch-preset-window-height" },
  { "bind": "Mod+Ctrl+R", "label": "Reset window height", "niri": "reset-window-height" },
  { "bind": "Mod+Minus", "label": "Narrow column by 10%", "niri": "set-column-width \"-10%\"" },
  { "bind": "Mod+Equal", "label": "Widen column by 10%", "niri": "set-column-width \"+10%\"" },
  { "bind": "Mod+Shift+Minus", "label": "Shrink window by 10%", "niri": "set-window-height \"-10%\"" },
  { "bind": "Mod+Shift+Equal", "label": "Grow window by 10%", "niri": "set-window-height \"+10%\"" },
  { "bind": "Mod+T", "label": "Toggle floating", "niri": "toggle-window-floating" },
  { "bind": "Mod+F", "label": "Maximize column", "niri": "maximize-column" },
  { "bind": "Mod+Shift+F", "label": "Fullscreen window", "niri": "fullscreen-window" },
  { "bind": "Mod+C", "label": "Toggle tabbed column", "niri": "toggle-column-tabbed-display" },
  { "bind": "Mod+M", "label": "Maximize window to edges", "niri": "maximize-window-to-edges" },

  { "section": "System" },
  { "bind": "Mod+Space", "label": "Switch keyboard layout", "niri": "switch-layout \"next\"", "overlay": true },
  { "bind": "Mod+Shift+Slash", "label": "Niri shortcut list", "niri": "show-hotkey-overlay" },
  { "bind": "Mod+Shift+Escape", "label": "Release shortcuts held by an app", "niri": "toggle-keyboard-shortcuts-inhibit", "options": "allow-inhibiting=false" },
  { "bind": "Mod+Shift+P", "label": "Turn off monitors", "niri": "power-off-monitors" },
  { "bind": "Ctrl+Alt+Delete", "label": "Quit Niri", "niri": "quit" },

  { "section": "Media keys" },
  { "bind": "XF86AudioRaiseVolume", "label": "Raise volume", "sh": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%+", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86AudioLowerVolume", "label": "Lower volume", "sh": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86AudioMute", "label": "Mute the output", "sh": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86AudioMicMute", "label": "Mute the microphone", "sh": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86AudioNext", "label": "Next track", "sh": "playerctl next", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86AudioPrev", "label": "Previous track", "sh": "playerctl previous", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86AudioPlay", "label": "Play or pause", "sh": "playerctl play-pause", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86AudioPause", "label": "Play or pause", "sh": "playerctl play-pause", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86MonBrightnessUp", "label": "Raise brightness", "ipc": "brightness increase", "options": "allow-when-locked=true", "manual": false },
  { "bind": "XF86MonBrightnessDown", "label": "Lower brightness", "ipc": "brightness decrease", "options": "allow-when-locked=true", "manual": false }
]
