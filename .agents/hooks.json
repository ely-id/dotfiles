{
  "estado-do-projeto": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/antigravity-inicio.py",
        "timeout": 15
      }
    ]
  },
  "protecao-de-arquivos": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/antigravity-protecao.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
